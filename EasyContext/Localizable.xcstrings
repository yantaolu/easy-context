    "配置文件损坏，已备份为 config.json.bak，当前使用默认设置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Config file is corrupted. It was backed up as config.json.bak; using default settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定檔已損毀，已備份為 config.json.bak，目前使用預設設定"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定ファイルが破損しています。config.json.bak としてバックアップし、デフォルト設定を使用中です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurationsdatei ist beschädigt. Sie wurde als config.json.bak gesichert; Standardeinstellungen werden verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de configuration est corrompu. Il a été sauvegardé sous config.json.bak ; réglages par défaut utilisés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de configuración está dañado. Se guardó como config.json.bak; se usan los ajustes predeterminados."
          }
        }
      }
    },
    "访达扩展尚未启用，右键菜单不会出现": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Finder extension isn't enabled yet, so the right-click menu won't appear."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 擴充功能尚未啟用，右鍵選單不會出現"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 機能拡張がまだ有効になっていないため、右クリックメニューは表示されません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Finder-Erweiterung ist noch nicht aktiviert, daher erscheint das Rechtsklick-Menü nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'extension Finder n'est pas encore activée, le menu clic droit n'apparaîtra pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La extensión del Finder aún no está activada, por lo que el menú contextual no aparecerá."
          }
        }
      }
    },
