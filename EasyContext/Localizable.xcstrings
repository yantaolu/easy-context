            "state": "translated",
            "value": "Selecciona un terminal para editar su plantilla de inicio."
          }
        }
      }
    },
    "Settings can't be written to disk. Changes apply to this session only.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置无法写入磁盘，更改仅本次运行期间生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定無法寫入磁碟，變更僅在本次執行期間生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定をディスクに書き込めません。変更は今回の起動中のみ有効です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen können nicht auf die Festplatte geschrieben werden. Änderungen gelten nur für diese Sitzung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer les réglages sur le disque. Les modifications ne s'appliquent qu'à cette session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden guardar los ajustes en el disco. Los cambios solo se aplican a esta sesión."
          }
        }
      }
    },
    "Templates…": {
      "localizations": {
