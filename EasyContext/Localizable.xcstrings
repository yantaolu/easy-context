            "state": "translated",
            "value": "設定をディスクに書き込めません。変更は今回の起動中のみ有効です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen können nicht auf die Festplatte geschrieben werden. Änderungen gelten nur für diese Sitzung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer les réglages sur le disque. Les modifications ne s'appliquent qu'à cette session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden guardar los ajustes en el disco. Los cambios solo se aplican a esta sesión."
          }
        }
      }
    },
    "Terminals shown in menu": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單顯示的終端機"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューに表示するターミナル"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Menü angezeigte Terminals"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminaux affichés dans le menu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminales mostrados en el menú"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单显示的终端"
          }
        }
      }
    },
    "The Finder extension isn't enabled yet, so the right-click menu won't appear.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 擴充功能尚未啟用，右鍵選單不會出現"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 機能拡張がまだ有効になっていないため、右クリックメニューは表示されません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Finder-Erweiterung ist noch nicht aktiviert, daher erscheint das Kontextmenü nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'extension Finder n'est pas encore activée, le menu contextuel n'apparaîtra pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La extensión del Finder aún no está activada, por lo que el menú contextual no aparecerá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访达扩展尚未启用，右键菜单不会出现"
          }
        }
      }
    },
    "The command exited with an error.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令执行出错并退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指令執行出錯並結束。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドがエラーで終了しました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Befehl wurde mit einem Fehler beendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande s'est terminée avec une erreur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comando terminó con un error."
          }
        }
      }
    },
    "The request could not be verified. Please try again from the right-click menu.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证该请求。请从右键菜单重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證該請求。請從右鍵選單重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストを検証できませんでした。右クリックメニューからもう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage konnte nicht verifiziert werden. Bitte versuchen Sie es erneut über das Kontextmenü."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La requête n'a pas pu être vérifiée. Veuillez réessayer depuis le menu contextuel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la solicitud. Inténtalo de nuevo desde el menú contextual."
          }
        }
      }
    },
    "This app doesn't declare that it can open folders, so clicking it from the right-click menu may not open the directory. Add it anyway?": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此應用程式未宣告可開啟資料夾，從右鍵選單點按它時可能無法正常開啟資料夾。仍要新增嗎？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この App はフォルダを開けると宣言していないため、右クリックメニューから選んでもディレクトリを開けないことがあります。追加しますか？"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App gibt nicht an, dass sie Ordner öffnen kann. Beim Klick im Kontextmenü wird der Ordner möglicherweise nicht geöffnet. Trotzdem hinzufügen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app ne déclare pas pouvoir ouvrir des dossiers ; en cliquant depuis le menu contextuel, le dossier pourrait ne pas s'ouvrir. L'ajouter quand même ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app no declara que pueda abrir carpetas, así que al hacer clic desde el menú contextual puede que no abra el directorio. ¿Añadirla de todos modos?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该应用未声明可打开文件夹，从右键菜单点击它时可能无法正常打开目录。仍要添加吗？"
          }
        }
      }
    },
    "This command was renamed or disabled. Reopen the right-click menu and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该命令已被重命名或停用。请重新打开右键菜单再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該指令已被重新命名或停用。請重新打開右鍵選單再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコマンドは名前が変更されたか、無効になっています。右クリックメニューを開き直して、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Befehl wurde umbenannt oder deaktiviert. Öffnen Sie das Kontextmenü erneut und versuchen Sie es noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette commande a été renommée ou désactivée. Rouvrez le menu contextuel et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este comando fue renombrado o desactivado. Vuelve a abrir el menú contextual e inténtalo de nuevo."
          }
        }
      }
    },
    "Undo": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還原"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消す"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widerrufen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshacer"
          }
        }
      }
    },
    "macOS is blocking Easy Context from controlling the terminal. Enable Easy Context in System Settings → Privacy & Security → Automation, then try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 正在阻止 Easy Context 控制终端。请在「系统设置 → 隐私与安全性 → 自动化」中允许 Easy Context，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 正在阻止 Easy Context 控制終端機。請在「系統設定 → 隱私權與安全性 → 自動化」中允許 Easy Context，然後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS が Easy Context によるターミナルの制御をブロックしています。「システム設定 → プライバシーとセキュリティ → オートメーション」で Easy Context を許可してから、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS blockiert die Steuerung des Terminals durch Easy Context. Erlauben Sie Easy Context unter „Systemeinstellungen → Datenschutz & Sicherheit → Automatisierung“ und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS empêche Easy Context de contrôler le terminal. Autorisez Easy Context dans Réglages Système → Confidentialité et sécurité → Automatisation, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS está impidiendo que Easy Context controle el terminal. Permite Easy Context en Ajustes del Sistema → Privacidad y seguridad → Automatización y vuelve a intentarlo."
          }
        }
      }
    },
    "“%@” has no launch template configured. Please add one in EasyContext settings.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」尚未設定啟動範本，請在 EasyContext 設定中為它填寫範本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」に起動テンプレートが設定されていません。EasyContext の設定でテンプレートを入力してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für „%@“ ist keine Startvorlage konfiguriert. Bitte lege in den EasyContext-Einstellungen eine an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun modèle de lancement n'est configuré pour « %@ ». Ajoutez-en un dans les réglages d'EasyContext."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no tiene una plantilla de inicio configurada. Añádela en los ajustes de EasyContext."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 未配置启动模板，请在 EasyContext 设置里为它填写模板。"
          }
        }
      }
    },
    "“%@” may not support opening folders": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」可能不支援以目錄方式開啟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はフォルダを開くことに対応していない可能性があります"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ unterstützt möglicherweise kein Öffnen von Ordnern"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne prend peut-être pas en charge l'ouverture de dossiers"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» podría no admitir la apertura de carpetas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 可能不支持以目录方式打开"
          }
        }
      }
    }
  },
  "version": "1.0"
}
