    "Command name already exists. Please choose a different name.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令名称已存在。请选择其他名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "命令名稱已存在。請選擇其他名稱。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じコマンド名がすでにあります。別の名前を選んでください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Befehlsname ist bereits vorhanden. Wähle einen anderen Namen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce nom de commande existe déjà. Choisissez un autre nom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre del comando ya existe. Elige otro nombre."
          }
        }
      }
    },
    "Command name cannot be empty.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令名称不能为空。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "命令名稱不能為空。"
