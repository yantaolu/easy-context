    "Select a terminal to edit its launch template.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个终端以编辑其启动模板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個終端機以編輯其啟動範本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルを選択して起動テンプレートを編集します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie ein Terminal aus, um seine Startvorlage zu bearbeiten."
          }
        },
        "fr": {
          "stringUnit": {
