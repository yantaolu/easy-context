    "⚠ 该终端从外部运行命令会弹确认且可能多开窗口，建议改用 Terminal / iTerm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Running commands externally in this terminal may prompt for confirmation and open extra windows. Use Terminal / iTerm instead."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ 此終端機從外部執行指令會跳出確認且可能開啟多個視窗，建議改用 Terminal / iTerm"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ このターミナルで外部からコマンドを実行すると確認が表示され、複数のウインドウが開くことがあります。Terminal / iTerm の使用をおすすめします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Wenn Befehle extern in diesem Terminal ausgeführt werden, erscheint eine Bestätigung und es öffnen sich ggf. mehrere Fenster. Verwende stattdessen Terminal / iTerm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ L'exécution externe de commandes dans ce terminal peut demander une confirmation et ouvrir plusieurs fenêtres. Utilisez plutôt Terminal / iTerm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Ejecutar comandos externamente en esta terminal puede pedir confirmación y abrir varias ventanas. Usa Terminal / iTerm en su lugar."
          }
        }
      }
    },
