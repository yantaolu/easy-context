    "Terminal Launch Templates": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端启动模板"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機啟動範本"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナル起動テンプレート"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal-Startvorlagen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèles de lancement du terminal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plantillas de inicio del terminal"
          }
        }
      }
    },
    "Terminals need a launch template to run commands. Terminals without one can't be used as the execution terminal until you add a template here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端需要启动模板才能运行命令。没有模板的终端无法被选为执行终端，在这里为它添加模板即可启用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機需要啟動範本才能執行指令。沒有範本的終端機無法被選為執行終端機，在這裡為它新增範本即可啟用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドを実行するにはターミナルに起動テンプレートが必要です。テンプレートのないターミナルは、ここでテンプレートを追加するまで実行ターミナルとして使用できません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminals benötigen eine Startvorlage, um Befehle auszuführen. Terminals ohne Vorlage können erst als Ausführungsterminal verwendet werden, wenn Sie hier eine hinzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les terminaux ont besoin d'un modèle de lancement pour exécuter des commandes. Les terminaux sans modèle ne peuvent pas servir de terminal d'exécution tant que vous n'en ajoutez pas un ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los terminales necesitan una plantilla de inicio para ejecutar comandos. Los terminales sin plantilla no pueden usarse como terminal de ejecución hasta que añadas una aquí."
          }
        }
      }
    },
    "Terminals shown in menu": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單顯示的終端機"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューに表示するターミナル"
          }
        },
        "de": {
