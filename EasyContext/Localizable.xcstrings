        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンド名は空にできません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Befehlsname darf nicht leer sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom de la commande ne peut pas être vide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre del comando no puede estar vacío."
          }
        }
      }
    },
