#!/bin/bash
# 覆盖安装【前】执行：关闭正在运行的 EasyContext 与其 FinderSync 扩展，
# 释放对 .app 包的占用，避免“项目 EasyContext.app 正在使用中”导致安装失败。
#
# 安装器以 root 身份运行本脚本。进程退出仅是覆盖安装的准备工作：任何失败都
# 记录到 Installer 日志，但不得阻止已验证的 payload 安装。

LOG_PREFIX="[EasyContext installer:preinstall]"

log() {
  printf '%s %s\n' "$LOG_PREFIX" "$*"
}

warn() {
  printf '%s WARNING: %s\n' "$LOG_PREFIX" "$*" >&2
}

# 0) 记录即将被覆盖的旧版签名身份，供 postinstall 判断旧隐私授权是否已失效。
# INSTALLER_TEMP 是 Installer 为同一次安装的脚本提供的私有临时目录（root 所有）。
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TARGET_VOLUME="${3:-/}"
if [ "$TARGET_VOLUME" = "/" ]; then
  OLD_APP_PATH="/Applications/EasyContext.app"
else
  OLD_APP_PATH="${TARGET_VOLUME%/}/Applications/EasyContext.app"
fi
OLD_APPEX_PATH="$OLD_APP_PATH/Contents/PlugIns/EasyContextFinder.appex"
if [ -z "${INSTALLER_TEMP:-}" ] || [ ! -d "$INSTALLER_TEMP" ]; then
  log "INSTALLER_TEMP unavailable; skipping signing identity snapshot."
elif ! . "$SCRIPT_DIR/easycontext-installer-lib.sh"; then
  warn "Installer helper library missing; skipping signing identity snapshot."
elif [ -d "$OLD_APP_PATH" ]; then
  ec_designated_requirement "$OLD_APP_PATH" > "$INSTALLER_TEMP/easycontext-old-app.requirement" \
    || warn "Could not record the previous application signing identity."
  ec_designated_requirement "$OLD_APPEX_PATH" > "$INSTALLER_TEMP/easycontext-old-appex.requirement" \
    || warn "Could not record the previous Finder extension signing identity."
  log "Recorded the previous signing identity."
else
  log "No previous installation found; nothing to record."
fi

# 非当前启动卷（离线目标卷）上没有对应的运行中进程，不关闭当前会话里的 App。
if [ "$TARGET_VOLUME" != "/" ]; then
  log "Offline target volume; skipping app termination."
  exit 0
fi

CONSOLE_USER=""
if ! CONSOLE_USER="$(/usr/bin/stat -f '%Su' /dev/console)"; then
  warn "Could not determine the console user; skipping polite app quit."
fi

# 1) 先以登录用户身份礼貌退出宿主 App（菜单栏后台应用，无 Dock 图标）。
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
  log "Requesting a graceful quit for EasyContext as $CONSOLE_USER."
  if ! /usr/bin/sudo -u "$CONSOLE_USER" /usr/bin/osascript -e 'quit app "EasyContext"'; then
    warn "Graceful EasyContext quit failed; continuing with exact process termination."
  fi
else
  log "No non-root console user; skipping graceful EasyContext quit."
fi

if ! /bin/sleep 1; then
  warn "Could not wait after the graceful quit request."
fi

# 2) 兜底结束宿主与 FinderSync 扩展进程。-x 只匹配真实进程名，避免误伤命令
# 行中恰好包含 EasyContextFinder 的其它程序。
terminate_if_running() {
  local process_name="$1"
  local status

  if /usr/bin/pkill -x "$process_name"; then
    log "Terminated running process: $process_name."
    return 0
  else
    status=$?
    if [ "$status" -eq 1 ]; then
      log "Process is not running: $process_name."
    else
      warn "Could not terminate $process_name (pkill exit $status); installation will continue."
    fi
  fi
}

terminate_if_running "EasyContext"
terminate_if_running "EasyContextFinder"

if ! /bin/sleep 1; then
  warn "Could not wait after process termination."
fi

log "Preinstall preparation complete."
exit 0
