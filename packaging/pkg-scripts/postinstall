#!/bin/bash
# 安装完成【后】执行：显式注册新版 FinderSync 扩展 → 启动宿主 → 重启访达。
#
# 为什么要显式注册 + 重启访达：覆盖安装会使旧插件注册失效（pkd 里的 UUID
# 指向已被替换的 bundle），若等系统自行重扫，可能拖到用户下次打开设置页
# 才注册（实测出现过 19 分钟的「右键菜单消失」空窗）。pluginkit -a 立即
# 注册新 appex，killall Finder 让访达立即挂接（访达会自动重启并恢复窗口）。
#
# 注意：绝不能以 root 直接执行宿主——那样 getuid()==0，配置会读写到
# /var/root/.easy-context 而不是用户家目录，导致“配置不生效”。故用
# launchctl asuser + sudo -u 切回登录用户。辅助操作失败只告警：App payload
# 已安装时，不应因刷新 Finder 失败而使 Installer 回滚。

LOG_PREFIX="[EasyContext installer:postinstall]"

log() {
  printf '%s %s\n' "$LOG_PREFIX" "$*"
}

warn() {
  printf '%s WARNING: %s\n' "$LOG_PREFIX" "$*" >&2
}

fatal() {
  printf '%s ERROR: %s\n' "$LOG_PREFIX" "$*" >&2
  exit 1
}

# $3 是 Installer 的目标卷。通常为 /；保留它可使离线目标卷安装时也校验
# 正确的 payload，而不会硬编码当前启动卷。
TARGET_VOLUME="${3:-/}"
if [ "$TARGET_VOLUME" = "/" ]; then
  APP_PATH="/Applications/EasyContext.app"
else
  APP_PATH="${TARGET_VOLUME%/}/Applications/EasyContext.app"
fi
APPEX_PATH="$APP_PATH/Contents/PlugIns/EasyContextFinder.appex"
APP_EXECUTABLE="$APP_PATH/Contents/MacOS/EasyContext"
APPEX_EXECUTABLE="$APPEX_PATH/Contents/MacOS/EasyContextFinder"

require_directory() {
  local path="$1"
  local label="$2"
  if [ ! -d "$path" ]; then
    fatal "Required $label is missing: $path"
  fi
}

require_executable() {
  local path="$1"
  local label="$2"
  if [ ! -f "$path" ] || [ ! -x "$path" ]; then
    fatal "Required $label is missing or not executable: $path"
  fi
}

# 这些是 payload 完整性的最低条件；不存在时安装不能被视为成功。
require_directory "$APP_PATH" "application bundle"
require_directory "$APPEX_PATH" "Finder extension bundle"
require_executable "$APP_EXECUTABLE" "application executable"
require_executable "$APPEX_EXECUTABLE" "Finder extension executable"
log "Verified installed payload at $APP_PATH."

CONSOLE_USER=""
if ! CONSOLE_USER="$(/usr/bin/stat -f '%Su' /dev/console)"; then
  warn "Could not determine the console user; skipping extension registration and launch."
fi

if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ]; then
  warn "No non-root console user; skipping extension registration, app launch, and Finder refresh."
  exit 0
fi

CONSOLE_UID=""
if ! CONSOLE_UID="$(/usr/bin/id -u "$CONSOLE_USER")" || [ -z "$CONSOLE_UID" ]; then
  warn "Could not determine UID for console user $CONSOLE_USER; skipping extension registration and launch."
  exit 0
fi

run_as_console_user() {
  /bin/launchctl asuser "$CONSOLE_UID" /usr/bin/sudo -u "$CONSOLE_USER" "$@"
}

run_optional() {
  local description="$1"
  shift
  local status

  log "$description."
  if run_as_console_user "$@"; then
    log "Completed: $description."
    return 0
  else
    status=$?
    warn "Failed: $description (exit $status); installed App remains available."
    return 0
  fi
}

# 1) 立即注册新 appex（不等系统慢扫）。
run_optional "Registering Finder extension" /usr/bin/pluginkit -a "$APPEX_PATH"
# 2) 启动宿主（生成 IPC token / 模板参考文件、注册 URL scheme）。
run_optional "Launching EasyContext" /usr/bin/open "$APP_PATH"
# 3) 重启访达，立即挂接新版扩展。
run_optional "Refreshing Finder" /usr/bin/killall Finder

log "Postinstall actions complete."
exit 0
