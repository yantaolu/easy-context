#!/bin/bash
# 安装完成【后】执行：显式注册新版 FinderSync 扩展 → 启动宿主 → 重启访达。
#
# 为什么要显式注册 + 重启访达：覆盖安装会使旧插件注册失效（pkd 里的 UUID
# 指向已被替换的 bundle），若等系统自行重扫，可能拖到用户下次打开设置页
# 才注册（实测出现过 19 分钟的「右键菜单消失」空窗）。pluginkit -a 立即
# 注册新 appex，killall Finder 让访达立即挂接（访达会自动重启并恢复窗口）。
#
# 注意：绝不能以 root 直接执行宿主——那样 getuid()==0，配置会读写到
# /var/root/.easy-context 而不是用户家目录，导致“配置不生效”。故用
# launchctl asuser + sudo -u 切回登录用户。辅助操作失败只告警：App payload
# 已安装时，不应因刷新 Finder 失败而使 Installer 回滚。

LOG_PREFIX="[EasyContext installer:postinstall]"

log() {
  printf '%s %s\n' "$LOG_PREFIX" "$*"
}

warn() {
  printf '%s WARNING: %s\n' "$LOG_PREFIX" "$*" >&2
}

fatal() {
  printf '%s ERROR: %s\n' "$LOG_PREFIX" "$*" >&2
  exit 1
}

# $3 是 Installer 的目标卷。通常为 /；保留它可使离线目标卷安装时也校验
# 正确的 payload，而不会硬编码当前启动卷。
TARGET_VOLUME="${3:-/}"
if [ "$TARGET_VOLUME" = "/" ]; then
  APP_PATH="/Applications/EasyContext.app"
else
  APP_PATH="${TARGET_VOLUME%/}/Applications/EasyContext.app"
fi
APPEX_PATH="$APP_PATH/Contents/PlugIns/EasyContextFinder.appex"
APP_EXECUTABLE="$APP_PATH/Contents/MacOS/EasyContext"
APPEX_EXECUTABLE="$APPEX_PATH/Contents/MacOS/EasyContextFinder"
EXPECTED_VERSION="@EXPECTED_VERSION@"
EXPECTED_BUILD_NUMBER="@EXPECTED_BUILD_NUMBER@"
EXPECTED_APP_EXECUTABLE_SHA256="@APP_EXECUTABLE_SHA256@"
EXPECTED_APPEX_EXECUTABLE_SHA256="@APPEX_EXECUTABLE_SHA256@"

require_directory() {
  local path="$1"
  local label="$2"
  if [ ! -d "$path" ]; then
    fatal "Required $label is missing: $path"
  fi
}

require_executable() {
  local path="$1"
  local label="$2"
  if [ ! -f "$path" ] || [ ! -x "$path" ]; then
    fatal "Required $label is missing or not executable: $path"
  fi
}

# 这些是 payload 完整性的最低条件；不存在时安装不能被视为成功。
require_directory "$APP_PATH" "application bundle"
require_directory "$APPEX_PATH" "Finder extension bundle"
require_executable "$APP_EXECUTABLE" "application executable"
require_executable "$APPEX_EXECUTABLE" "Finder extension executable"

require_plist_value() {
  local plist="$1"
  local key="$2"
  local expected="$3"
  local actual
  if ! actual="$(/usr/libexec/PlistBuddy -c "Print :$key" "$plist" 2>/dev/null)"; then
    fatal "Could not read $key from $plist"
  fi
  if [ "$actual" != "$expected" ]; then
    fatal "$plist has $key=$actual; expected $expected. The payload may have been skipped."
  fi
}

require_sha256() {
  local path="$1"
  local expected="$2"
  local actual
  if ! actual="$(/usr/bin/shasum -a 256 "$path" | /usr/bin/awk '{print $1}')"; then
    fatal "Could not calculate SHA-256 for $path"
  fi
  if [ "$actual" != "$expected" ]; then
    fatal "$path does not match the packaged executable SHA-256. The payload may have been skipped or altered."
  fi
}

require_plist_value "$APP_PATH/Contents/Info.plist" CFBundleShortVersionString "$EXPECTED_VERSION"
require_plist_value "$APP_PATH/Contents/Info.plist" CFBundleVersion "$EXPECTED_BUILD_NUMBER"
require_plist_value "$APPEX_PATH/Contents/Info.plist" CFBundleShortVersionString "$EXPECTED_VERSION"
require_plist_value "$APPEX_PATH/Contents/Info.plist" CFBundleVersion "$EXPECTED_BUILD_NUMBER"
require_sha256 "$APP_EXECUTABLE" "$EXPECTED_APP_EXECUTABLE_SHA256"
require_sha256 "$APPEX_EXECUTABLE" "$EXPECTED_APPEX_EXECUTABLE_SHA256"
log "Verified installed payload version and executables at $APP_PATH."

# An offline target volume has no matching GUI session. Payload verification is
# complete, so do not register, launch, or refresh anything on the startup disk.
if [ "$TARGET_VOLUME" != "/" ]; then
  log "Offline target volume verified; skipping runtime registration and launch."
  exit 0
fi

CONSOLE_USER=""
if ! CONSOLE_USER="$(/usr/bin/stat -f '%Su' /dev/console)"; then
  warn "Could not determine the console user; skipping extension registration and launch."
fi

if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ]; then
  warn "No non-root console user; skipping extension registration, app launch, and Finder refresh."
  exit 0
fi

CONSOLE_UID=""
if ! CONSOLE_UID="$(/usr/bin/id -u "$CONSOLE_USER")" || [ -z "$CONSOLE_UID" ]; then
  warn "Could not determine UID for console user $CONSOLE_USER; skipping extension registration and launch."
  exit 0
fi

run_as_console_user() {
  /bin/launchctl asuser "$CONSOLE_UID" /usr/bin/sudo -u "$CONSOLE_USER" "$@"
}

run_optional() {
  local description="$1"
  shift
  local status

  log "$description."
  if run_as_console_user "$@"; then
    log "Completed: $description."
    return 0
  else
    status=$?
    warn "Failed: $description (exit $status); installed App remains available."
    return 0
  fi
}

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
HAVE_LIB=false
if . "$SCRIPT_DIR/easycontext-installer-lib.sh"; then
  HAVE_LIB=true
else
  warn "Installer helper library missing; skipping permission reset and stale registration cleanup."
fi

# 0a) 签名身份变化 → 清掉已失效的隐私授权。旧授权的开关仍显示开启、实际却不再匹配，
# 访问会被静默拒绝（典型表现：外置磁盘提示没有权限）；重置后 macOS 会重新弹框询问。
# 身份未变（同一证书签名的升级）不重置，保留用户已给的授权。
# 用户库（可移除宗卷、自动化等）以登录用户身份重置；系统库（完全磁盘访问）以 root 重置。
# 只能按宿主 bundle id 重置：tccutil 经 LaunchServices 按「应用程序」解析 id，对 Finder
# 扩展 id 恒报 -10814（No such bundle identifier）。宿主与扩展同时签名，任一方身份变化
# 都按宿主重置；扩展访问文件时的授权同样归属于宿主 App。
signing_identity_changed() {
  local bundle_path="$1"
  local record="$2"
  local old_requirement
  [ -f "$record" ] || return 1
  old_requirement="$(/bin/cat "$record")"
  /bin/rm -f "$record"
  ec_requirement_changed "$old_requirement" "$(ec_designated_requirement "$bundle_path")"
}

if [ "$HAVE_LIB" = true ] && [ -n "${INSTALLER_TEMP:-}" ]; then
  identity_changed=false
  if signing_identity_changed "$APP_PATH" "$INSTALLER_TEMP/easycontext-old-app.requirement"; then
    identity_changed=true
  fi
  if signing_identity_changed "$APPEX_PATH" "$INSTALLER_TEMP/easycontext-old-appex.requirement"; then
    identity_changed=true
  fi
  if [ "$identity_changed" = true ]; then
    log "Signing identity changed; previous privacy permissions no longer apply."
    run_optional "Resetting user privacy permissions for $EC_APP_ID" /usr/bin/tccutil reset All "$EC_APP_ID"
    if /usr/bin/tccutil reset All "$EC_APP_ID"; then
      log "Completed: resetting system privacy permissions for $EC_APP_ID."
    else
      warn "Failed: resetting system privacy permissions for $EC_APP_ID; installed App remains available."
    fi
  else
    log "Signing identity unchanged; keeping privacy permissions."
  fi
fi

# 0b) 注销其它位置登记的同 bundle id 副本（旧开发构建、已删除的目录等）。它们会与
# 已安装版争抢 easycontext:// 请求和隐私授权。只注销登记，绝不删除任何文件。
unregister_stale_copies() {
  local listing
  local stale_path
  if listing="$(run_as_console_user /usr/bin/pluginkit -mAvvv -i "$EC_APPEX_ID" 2>/dev/null)"; then
    while IFS= read -r stale_path; do
      [ -n "$stale_path" ] || continue
      run_optional "Unregistering stale Finder extension at $stale_path" \
        /usr/bin/pluginkit -r "$stale_path"
    done <<EOF
$(printf '%s\n' "$listing" | ec_other_plugin_paths "$APPEX_PATH")
EOF
  else
    warn "Could not list Finder extension registrations."
  fi

  if listing="$(run_as_console_user "$EC_LSREGISTER" -dump 2>/dev/null)"; then
    while IFS= read -r stale_path; do
      [ -n "$stale_path" ] || continue
      run_optional "Unregistering stale application copy at $stale_path" \
        "$EC_LSREGISTER" -u "$stale_path"
    done <<EOF
$(printf '%s\n' "$listing" | ec_other_registered_app_paths "$EC_APP_ID" "$APP_PATH")
EOF
  else
    warn "Could not read the LaunchServices database."
  fi
}

if [ "$HAVE_LIB" = true ]; then
  unregister_stale_copies
fi

# 1) 立即注册新 appex（不等系统慢扫）。
run_optional "Registering Finder extension" /usr/bin/pluginkit -a "$APPEX_PATH"
# 2) 启动宿主（生成 IPC token / 模板参考文件、注册 URL scheme）。
run_optional "Launching EasyContext" /usr/bin/open "$APP_PATH"
# 3) 重启访达，立即挂接新版扩展。
# 注册扩展、启动宿主后，LaunchServices 会在十几秒内多次重建该 App 的登记，每次扩展
# 登记都会换新 UUID。若访达在此期间重启，它会拿着过期 UUID 连接扩展、失败后放弃
# （日志：Unable to acquire process assertion … killing plugin），右键菜单消失。
# 因此先等登记连续数秒不变再重启访达，并确认扩展进程确实启动，否则再试一次。
registration_signature() {
  run_as_console_user /usr/bin/pluginkit -mAvvv -i "$EC_APPEX_ID" 2>/dev/null \
    | ec_plugin_registration_signature "$APPEX_PATH"
}

wait_for_stable_registration() {
  local previous=""
  local current
  local stable=0
  local waited=0
  while [ "$waited" -lt 30 ]; do
    current="$(registration_signature)"
    if [ -n "$current" ] && [ "$current" = "$previous" ]; then
      stable=$((stable + 1))
      if [ "$stable" -ge 3 ]; then
        log "Finder extension registration is stable after ${waited}s."
        return 0
      fi
    else
      stable=0
    fi
    previous="$current"
    /bin/sleep 1
    waited=$((waited + 1))
  done
  warn "Finder extension registration did not settle within 30s; refreshing Finder anyway."
  return 1
}

extension_pids() {
  /usr/bin/pgrep -u "$CONSOLE_UID" -x EasyContextFinder 2>/dev/null | /usr/bin/tr '\n' ' '
}

# 重启前的扩展进程会随旧访达退出，不能算数；失败时扩展也会短暂启动后被杀。
# 因此要求出现重启前没有的新进程，且 3 秒后仍在运行。
new_extension_running() {
  local before=" $1 "
  local pid
  for pid in $(extension_pids); do
    case "$before" in *" $pid "*) ;; *) return 0 ;; esac
  done
  return 1
}

extension_started() {
  local before="$1"
  local waited=0
  while [ "$waited" -lt 15 ]; do
    if new_extension_running "$before"; then
      /bin/sleep 3
      new_extension_running "$before" && return 0
    fi
    /bin/sleep 1
    waited=$((waited + 1))
  done
  return 1
}

if [ "$HAVE_LIB" = true ]; then
  for attempt in 1 2; do
    wait_for_stable_registration || true
    pids_before="$(extension_pids)"
    run_optional "Refreshing Finder (attempt $attempt)" /usr/bin/killall Finder
    if extension_started "$pids_before"; then
      log "Finder extension is running."
      break
    fi
    if [ "$attempt" -eq 2 ]; then
      warn "Finder extension did not start; restart Finder or log out and back in to load it."
    else
      warn "Finder extension did not start; retrying once."
    fi
  done
else
  run_optional "Refreshing Finder" /usr/bin/killall Finder
fi

log "Postinstall actions complete."
exit 0
