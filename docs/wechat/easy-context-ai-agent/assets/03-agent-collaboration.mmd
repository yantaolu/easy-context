    classDef verify fill:#FFF0E1,stroke:#D57A2A,stroke-width:2px,color:#6D3A12,rx:14,ry:14;
    classDef feedback fill:#E5F6EF,stroke:#31936D,stroke-width:2px,color:#1D5A44,rx:14,ry:14;
    class A person;
    class B,C,D agent;
